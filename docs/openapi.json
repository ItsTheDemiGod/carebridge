{
 "components": {
  "schemas": {
   "AddedMedicine": {
    "additionalProperties": false,
    "properties": {
     "dose": {
      "enum": [
       "1/2 tablet",
       "1 tablet",
       "2 tablets",
       "1 capsule",
       "2 capsules",
       "5 ml",
       "10 ml",
       "1 puff",
       "2 puffs",
       "1 drop",
       "2 drops",
       "1 application"
      ],
      "title": "Dose",
      "type": "string"
     },
     "formulary_id": {
      "maxLength": 80,
      "title": "Formulary Id",
      "type": "string"
     },
     "schedule": {
      "$ref": "#/components/schemas/ScheduleEdit"
     },
     "strength_choice": {
      "maxLength": 40,
      "title": "Strength Choice",
      "type": "string"
     }
    },
    "required": [
     "formulary_id",
     "strength_choice",
     "dose",
     "schedule"
    ],
    "title": "AddedMedicine",
    "type": "object"
   },
   "AdherenceIn": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "maxLength": 10,
      "title": "Date",
      "type": "string"
     },
     "document_id": {
      "maxLength": 64,
      "title": "Document Id",
      "type": "string"
     },
     "med_ref": {
      "maxLength": 4,
      "title": "Med Ref",
      "type": "string"
     },
     "scheduled_time": {
      "maxLength": 5,
      "title": "Scheduled Time",
      "type": "string"
     },
     "status": {
      "enum": [
       "taken",
       "skipped"
      ],
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "document_id",
     "med_ref",
     "scheduled_time",
     "date",
     "status"
    ],
    "title": "AdherenceIn",
    "type": "object"
   },
   "Confirmations": {
    "additionalProperties": false,
    "properties": {
     "added_medicines": {
      "items": {
       "$ref": "#/components/schemas/AddedMedicine"
      },
      "maxItems": 10,
      "title": "Added Medicines",
      "type": "array"
     },
     "decisions": {
      "items": {
       "$ref": "#/components/schemas/MedicineDecision"
      },
      "maxItems": 40,
      "title": "Decisions",
      "type": "array"
     }
    },
    "title": "Confirmations",
    "type": "object"
   },
   "ConsentIn": {
    "properties": {
     "notice_version": {
      "title": "Notice Version",
      "type": "string"
     },
     "purposes": {
      "items": {
       "type": "string"
      },
      "title": "Purposes",
      "type": "array"
     }
    },
    "required": [
     "notice_version",
     "purposes"
    ],
    "title": "ConsentIn",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "LanguageIn": {
    "properties": {
     "language": {
      "enum": [
       "en",
       "ta",
       "hi"
      ],
      "title": "Language",
      "type": "string"
     }
    },
    "required": [
     "language"
    ],
    "title": "LanguageIn",
    "type": "object"
   },
   "MedicineDecision": {
    "additionalProperties": false,
    "properties": {
     "acknowledged_flags": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "title": "Acknowledged Flags",
      "type": "array"
     },
     "action": {
      "enum": [
       "confirm_as_extracted",
       "select_formulary_drug",
       "not_in_list",
       "remove"
      ],
      "title": "Action",
      "type": "string"
     },
     "formulary_id": {
      "anyOf": [
       {
        "maxLength": 80,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Formulary Id"
     },
     "index": {
      "minimum": 0.0,
      "title": "Index",
      "type": "integer"
     },
     "note": {
      "anyOf": [
       {
        "maxLength": 80,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     },
     "schedule_edit": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ScheduleEdit"
       },
       {
        "type": "null"
       }
      ]
     },
     "strength_choice": {
      "anyOf": [
       {
        "maxLength": 40,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Strength Choice"
     }
    },
    "required": [
     "index",
     "action"
    ],
    "title": "MedicineDecision",
    "type": "object"
   },
   "OverridesIn": {
    "additionalProperties": false,
    "properties": {
     "overrides": {
      "additionalProperties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "maxProperties": 40,
      "title": "Overrides",
      "type": "object"
     }
    },
    "title": "OverridesIn",
    "type": "object"
   },
   "ScheduleEdit": {
    "additionalProperties": false,
    "properties": {
     "duration_days": {
      "anyOf": [
       {
        "maximum": 365.0,
        "minimum": 1.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Duration Days"
     },
     "times_per_day": {
      "anyOf": [
       {
        "maximum": 6.0,
        "minimum": 1.0,
        "type": "integer"
       },
       {
        "const": "as_needed",
        "type": "string"
       }
      ],
      "title": "Times Per Day"
     },
     "timing_label": {
      "$ref": "#/components/schemas/TimingLabel"
     }
    },
    "required": [
     "times_per_day",
     "timing_label"
    ],
    "title": "ScheduleEdit",
    "type": "object"
   },
   "SessionIn": {
    "properties": {
     "language": {
      "default": "en",
      "enum": [
       "en",
       "ta",
       "hi"
      ],
      "title": "Language",
      "type": "string"
     }
    },
    "title": "SessionIn",
    "type": "object"
   },
   "TimingLabel": {
    "enum": [
     "morning",
     "afternoon",
     "evening",
     "night",
     "with_meals",
     "before_meals",
     "after_meals",
     "bedtime",
     "as_needed",
     "unspecified",
     "other"
    ],
    "title": "TimingLabel",
    "type": "string"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
