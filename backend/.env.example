GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_MAX_RETRIES=5

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_NUM_CTX=6144
OLLAMA_NUM_PREDICT=3000
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_IMAGE_SIDE=1280

# Phase 5 (no secrets here). Create the key with: python scripts\generate_data_key.py
CAREBRIDGE_DATA_KEY=
SESSION_TTL_HOURS=24
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_DOCS_PER_SESSION=10
JOB_QUEUE_MAX=3
JOB_TIMEOUT_SECONDS=900
DB_PATH=data/app/carebridge.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true behind HTTPS (the session cookie then gets the Secure flag)
COOKIE_SECURE=false

# Consent notice contact line (Phase 5c). Optional email; the name is shown alone when it is empty.
CONTACT_NAME=Demian
CONTACT_EMAIL=
